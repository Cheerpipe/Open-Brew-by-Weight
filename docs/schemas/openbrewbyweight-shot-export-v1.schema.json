        "preShot": {
          "type": "array",
          "description": "The latest occurrence of each kind before the shot.",
          "items": {
            "$ref": "#/$defs/traceEvent"
          }
        },
        "events": {
          "type": "array",
          "description": "In record order; times are not monotonic, so sort by atMs to present them.",
          "items": {
            "$ref": "#/$defs/traceEvent"
          }
        }
      }
    },
    "traceEvent": {
      "type": "object",
      "description": "One record: a and b as stored (their meaning per kind is in docs/SHOT_TRACE.md), a continuation merged into ext.",
      "required": [
        "type",
        "code",
        "name",
        "a",
        "b"
      ],
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Event: ms after the anchor."
        },
        "beforeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Pre-shot entry: ms before the anchor."
        },
        "type": {
          "enum": [
            "profile",
            "debug",
            "trace"
          ],
          "description": "Scale profile event, firmware debug code, or trace-only kind."
        },
        "code": {
          "type": "integer",
          "minimum": 0,
          "description": "Kind or debug code number."
        },
        "name": {
          "type": "string",
          "description": "Vocabulary name, or type_code when unknown."
        },
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer",
          "minimum": 0
        },
        "ext": {
          "type": "array",
          "description": "Continuation: head bits 0-15, a, b.",
          "items": {
            "type": "integer"
          }
        },
        "signal": {
          "type": "string",
          "description": "STATE_CHANGED: the signal name."
        },
        "initial": {
          "type": "boolean",
          "description": "STATE_CHANGED: first observation in the window."
        },
        "arg1": {
          "type": "integer",
          "minimum": 0,
          "description": "Pre-shot entry: full first argument."
        },
        "arg2": {
          "type": "integer",
          "minimum": 0,
          "description": "Pre-shot entry: second argument."
        },
        "repeats": {
          "type": "integer",
          "minimum": 0,
          "description": "Pre-shot entry: earlier occurrences folded into it."
        }
      }
    }
  }
