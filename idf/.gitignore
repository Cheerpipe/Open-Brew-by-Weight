# ESP-IDF build tree (generated). sdkconfig.defaults* and dependencies.lock
# are committed for reproducible Component Manager resolution.
build/
managed_components/
sdkconfig
sdkconfig.old
# Vendored trees stay local, except components the build requires: the
# empty stubs that main/idf_component.yml overrides are part of Component
# Manager resolution and must be committed like sdkconfig.defaults* and
# dependencies.lock.
third_party/*
!third_party/esp-modbus/
!third_party/esp_rainmaker/
!third_party/esp_insights/
!third_party/esp-sr/
