# Shared ESP-IDF defaults for Open Brew by Weight (Arduino-ESP32 as a
# component). Architecture-specific flash/PSRAM overlays live in
# sdkconfig.defaults.n16r8. Do not put CONFIG_IDF_TARGET here: idf.py set-target
# writes it into sdkconfig.
#
# Official firmware builds use ./scripts/dev build; ESP-IDF is the only
# supported build path (prebuilt Arduino-ESP32 libraries compile ALLOW_BSS out).

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# Pins the runtime-stats clock to esp_timer microseconds; the per-task CPU
# deltas in the loop phase profiler assume this unit.
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_IN_IRAM=y
# Builds refresh an existing sdkconfig when selected defaults change.
# Firmware reads core pins via xTaskGetCoreID regardless.
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# Product defaults (main/Kconfig.projbuild). Override with
# OPENBREWBYWEIGHT_EXTRA_FLAGS=-DOPEN_BREW_BY_WEIGHT_… when needed.
# Remote machine control is opt-in (Kconfig default n). Do not set =y here.
# Local menuconfig choices persist until selected defaults change or the build
# is run with --force-sdkconfig-regenerate.
# CONFIG_OPEN_BREW_BY_WEIGHT_ENABLE_REMOTE_MACHINE_CONTROL is not set
# Buzzer support follows the resolved hardware profile (speaker presence);
# do not force OPEN_BREW_BY_WEIGHT_ENABLE_BUZZER here.

# Open Brew by Weight runs at 80 MHz (setup() calls setCpuFrequencyMhz(80)).
# IDF's S3 default is 160; start already at 80 so cpu_start and setup agree.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# Use the measured -O2 resource profile for supported firmware builds.
# The build wrapper regenerates an existing sdkconfig when its selected level
# differs from the requested level.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Qualified flash/MMU profile for the supported S3 variant.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_MMU_PAGE_SIZE_64KB=y

# PSRAM heap + BSS in external RAM. Arduino-ESP32 ships this last option off.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# malloc() at or below this size allocates internal DRAM first; larger
# requests prefer PSRAM (heap_caps_malloc_default). 2048 keeps sub-2 KiB
# churn internal and moves 2-4 KiB library allocations to PSRAM to protect
# the largest contiguous internal block.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
# Keep a DMA/controller pool that regular malloc() cannot eat. Matches the
# Qualified value already present in generated n16r8 sdkconfig.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# A PSRAM .noinit segment for the in-flight shot trace: it survives panic,
# watchdog and software resets. The boot PSRAM test skips it; power-on
# contents are undefined and never trusted.
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
# Prefer PSRAM for Wi-Fi/lwIP buffers when the driver allows it (soak-tested
# SoftAP+STA+BLE on n16r8). Leaves more internal DRAM for BLE controller.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Task stacks stay internal: plain xTaskCreate still allocates internal stacks.
# CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y (legacy alias
# CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY) exists only so an mDNS task stack
# may live in PSRAM on modules without XIP. Do not create other tasks with
# PSRAM stacks
# (xTaskCreateWithCaps(..., MALLOC_CAP_SPIRAM)): flash writes disable both
# caches while IDF asserts the writing task's stack is internal, so
# flash-writing tasks (loop, network, httpd, persist) and VHCI paths fault.

# Core topology contract: the whole network stack (Wi-Fi driver, lwIP tcpip,
# esp_timer) stays on core 0 so RF-storm bursts cannot preempt the core-1
# control and scale loops (priority 1). Measured motive: the 2026-10-12
# ~0.9 s control-loop stalls during beacon-timeout storms, attributed via the
# audit log (machine mux wait=902 ms with hold=1.8 ms) — tcpip was the only
# high-priority task without affinity. Wi-Fi and esp_timer are explicit for
# durability; they already resolve to core 0.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y

# Bounded Wi-Fi pools for Web UI transfers, STA + SoftAP, and OTA. Static
# RX/TX buffers reserve ~1.6 KB each until deinit; 8/16 costs ~19.2 KB more
# internal DMA RAM than 6/6. RX_BA_WIN must stay <= min(2*STATIC_RX, DYNAMIC_RX).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
# Cache TX is only an overflow queue for frames that arrive while every static
# TX buffer is busy; queued lwIP packets are PSRAM-capable under
# SPIRAM_TRY_ALLOCATE_WIFI_LWIP. This bounds queueing, not preallocated DRAM.
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32
# Management short buffers are small (<64 B each) and allocated on demand;
# 16 covers STA + SoftAP association and beacon traffic.
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# IPv6 stays on so the station gets a link-local address and mDNS answers
# AAAA queries; without one, getaddrinfo-based clients stall ~5 s per .local
# lookup waiting for an answer that never comes. SoftAP stays IPv4-only.
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=3
# TCP payload buffers grow per active connection; keep the receive mailbox
# above WND/MSS + 2 (MSS=1440) so it can accommodate the larger window.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
# Peak with every network feature active: httpd (max_open_sockets + 3) = 10,
# mDNS 1, SNTP 1, DNS 1, webhook 1, Micra WSS 1 and HTTPS 1 = 16, plus 2 spare.
# Slots are allocated per open socket, and its buffers prefer PSRAM.
CONFIG_LWIP_MAX_SOCKETS=18
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=4
# No periodic gratuitous ARP: the 60 s broadcast was one TX wakeup per minute
# re-flooded to the whole LAN, against the traffic-economy rule. Offline risk
# is none: association lives at 802.11 level, and a router that aged our ARP
# entry gets an on-demand answer (unicast requests reach the DTIM-sleeping
# station buffered, like any unicast).
# CONFIG_LWIP_ESP_GRATUITOUS_ARP is not set
# mDNS advertises only (hostname + _http._tcp): two interfaces (STA + SoftAP),
# one service, no browse/CLI/multi-instance query machinery. Arduino pulls
# CONFIG_ETH_ENABLED in transitively, so the predefined Ethernet slot must be
# dropped explicitly or the responder counts 3 predefined interfaces against
# MAX_INTERFACES=2 and fails to compile.
CONFIG_MDNS_MAX_INTERFACES=2
CONFIG_MDNS_MAX_SERVICES=1
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# CONFIG_MDNS_PREDEF_NETIF_ETH is not set
# CONFIG_MDNS_ENABLE_CONSOLE_CLI is not set
# CONFIG_MDNS_ENABLE_BROWSE is not set
# CONFIG_MDNS_MULTIPLE_INSTANCE is not set
# SoftAP is WPA2-PSK (WiFi.softAP); STA may still join WPA3-SAE networks.
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# Central (scale) + optional Companion peripheral.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
# Discovery needs a dup cache; idle connected scanning does not need 100.
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=50
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50
CONFIG_BT_CTRL_BLE_ADV_REPORT_DISCARD_THRSHOLD=10
# API paths are short (/api/v1/...); keep headers wide (Safari) in httpd_config.
CONFIG_HTTPD_MAX_URI_LEN=128
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
# Less console IRQ time on the control cores.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL=4

# USB Serial/JTAG console stays off so the PHY is not started before setup().
# App CDC starts only when GPIO4 is jumpered to GND at boot (HWCDC begin),
# unless compiled with -DOPEN_BREW_BY_WEIGHT_ENABLE_JTAG=1 (sdkconfig.defaults.jtag).
# ROM USB download (BOOT+RST) still works. The build refreshes sdkconfig
# when the JTAG flag changes.
CONFIG_OPEN_BREW_BY_WEIGHT_ENABLE_JTAG=0
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Runtime policy defaults OFF (fixed 80 MHz); no automatic light sleep.
CONFIG_PM_ENABLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
# ScaleService disables controller sleep at boot and before GAP/GATT setup.

# Arduino setup()/loop() autostart. Arduino-ESP32 provides app_main.
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_LOOP_STACK_SIZE=8192
# Core 1 runs only control and scale_worker. Arduino's network event task
# (priority ESP_TASKD_EVENT_PRIO - 1) defaults to core 1; keep it with the
# Wi-Fi and lwIP tasks on core 0 so Wi-Fi events never preempt control.
CONFIG_ARDUINO_EVENT_RUN_CORE0=y
# FreeRTOS creates its timer service task without affinity; pin it to core 0
# so deferred timer callbacks never run on the control core.
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y

# Skip Matter/RainMaker/esp-sr/Zigbee Arduino wrappers. Open Brew by Weight only
# needs EEPROM, Preferences, Network and WiFi from the Arduino libraries.
CONFIG_ARDUINO_SELECTIVE_COMPILATION=y
CONFIG_ARDUINO_SELECTIVE_EEPROM=y
CONFIG_ARDUINO_SELECTIVE_Preferences=y
CONFIG_ARDUINO_SELECTIVE_Network=y
CONFIG_ARDUINO_SELECTIVE_WiFi=y
# Captive-portal DNS responder for the SoftAP onboarding flow.
CONFIG_ARDUINO_SELECTIVE_AsyncUDP=y
CONFIG_ARDUINO_SELECTIVE_DNSServer=y
# SoftAP+HTTP provisioning is implemented in OpenBrewByWeightNetwork; WiFiProv /
# network_provisioning is unused and only costs flash + init RAM.
# CONFIG_ARDUINO_SELECTIVE_WiFiProv is not set
# CONFIG_ARDUINO_SELECTIVE_ESP_SR is not set
# CONFIG_ARDUINO_SELECTIVE_ESP_Video is not set
# CONFIG_ARDUINO_SELECTIVE_Matter is not set
# CONFIG_ARDUINO_SELECTIVE_RainMaker is not set
# CONFIG_ARDUINO_SELECTIVE_Insights is not set
# CONFIG_ARDUINO_SELECTIVE_OpenThread is not set
# CONFIG_ARDUINO_SELECTIVE_Zigbee is not set
# CONFIG_ARDUINO_SELECTIVE_BLE is not set
# CONFIG_ARDUINO_SELECTIVE_BluetoothSerial is not set
# CONFIG_ARDUINO_SELECTIVE_SimpleBLE is not set
# CONFIG_ARDUINO_SELECTIVE_ArduinoOTA is not set
# CONFIG_ARDUINO_SELECTIVE_HTTPClient is not set
# CONFIG_ARDUINO_SELECTIVE_WebServer is not set
# CONFIG_ARDUINO_SELECTIVE_Ethernet is not set
# CONFIG_ARDUINO_SELECTIVE_PPP is not set
# CONFIG_ARDUINO_SELECTIVE_FS is not set
# CONFIG_ARDUINO_SELECTIVE_Update is not set
# CONFIG_ARDUINO_SELECTIVE_Hash is not set
# CONFIG_ARDUINO_SELECTIVE_SPI is not set
# CONFIG_ARDUINO_SELECTIVE_Wire is not set
# CONFIG_ARDUINO_SELECTIVE_Ticker is not set
# CONFIG_ARDUINO_SELECTIVE_ESPmDNS is not set
# CONFIG_ARDUINO_SELECTIVE_NetBIOS is not set
# CONFIG_ARDUINO_SELECTIVE_NetworkClientSecure is not set

# The native NimBLE host configuration is supplied by
# sdkconfig.defaults.nimble. It is the only BLE backend.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Compile-time requirements from OpenBrewByWeightWatchdog.h / OpenBrewByWeightOta.h /
# OpenBrewByWeightHardwareTimer.h. Arduino-ESP32 prebuilt libs already ship these.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=800
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=0
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_WDT_ENABLE=y
CONFIG_BOOTLOADER_WDT_TIME_MS=9000
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y

# IRAM budget. The RMT driver is linked only through the Arduino HAL (the
# buzzer uses LEDC) and nothing in the firmware uses it, so its ISR and encoder
# code stays in flash instead of costing ~3.6 KB of internal RAM.
# CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM is not set
# CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM is not set
# CONFIG_RMT_ENCODER_FUNC_IN_IRAM is not set
# GDMA only feeds the hardware SHA/AES engines (TLS, OTA digests), which the
# crypto port drives by polling from task context with caches enabled: no GDMA
# interrupt is registered and no DMA runs inside a cache-off flash window. The
# SPI master/slave ISR options are cleared only because they would force the
# GDMA code back into IRAM; no SPI peripheral driver is used.
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# CONFIG_SPI_SLAVE_ISR_IN_IRAM is not set
# CONFIG_GDMA_CTRL_FUNC_IN_IRAM is not set
# CONFIG_GDMA_ISR_HANDLER_IN_IRAM is not set
