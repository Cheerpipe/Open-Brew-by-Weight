#!/usr/bin/env bash
# Build the official ESP-IDF firmware with extra GCC warnings enabled
# (-Wunused-parameter, which ESP-IDF disables with -Wno-unused-parameter) and
# report only diagnostics located in project-owned code. Much faster than
# gcc_analyzer: no -fanalyzer interprocedural analysis is involved.
set -uo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/openbrewbyweight_board.sh
source "$SCRIPT_DIR/openbrewbyweight_board.sh"
# shellcheck source=scripts/openbrewbyweight_cli.sh
source "$SCRIPT_DIR/openbrewbyweight_cli.sh"

ROOT="$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)"
readonly ROOT
readonly OUTPUT_DIR="reports/gcc-warnings"
# A separate tree keeps -Wunused-parameter from reconfiguring build-idf/<variant>.
export OPENBREWBYWEIGHT_IDF_BUILD_ROOT="$ROOT/build-idf/warnings"
OBBW_IDF_BUILD_ROOT="$OPENBREWBYWEIGHT_IDF_BUILD_ROOT"

usage() {
  cat <<EOF
Usage: ./scripts/warnings-idf [flags]

Build Open Brew by Weight with the official ESP-IDF path plus extra GCC warnings
(currently -Wunused-parameter) and save the filtered result to
$OUTPUT_DIR/gcc-warnings.txt. Replaces the previous report. The full compile
log is kept in gcc-warnings-raw.txt; the main report keeps only diagnostics
whose primary location is versioned code in this repository.

The extra warning flags are never persisted to .openbrewbyweight; ordinary builds
stay unaffected.

For the slow interprocedural -fanalyzer pass use ./scripts/gcc_analyzer
instead. For cppcheck (no build required) use ./scripts/static-idf.

Required parameters: --hardware and --machine. --flags is optional and appended
to the warnings build.

$(obbw_flag_help)

$(openbrewbyweight_arch_help)

Examples:
  ./scripts/warnings-idf --hardware esp32-s3-relay-x1-speaker \
    --machine rancilio-silvia-pro-x
EOF
}

obbw_cli_parse "$@" || exit $?
if obbw_cli_help_requested; then
  usage
  exit 0
fi

obbw_cli_resolve "hardware_config machine_config webui_language" "flags" || exit $?

cd "$ROOT" || exit
output_path="$ROOT/$OUTPUT_DIR"
rm -rf "$output_path"
mkdir -p "$output_path"

# -Wunused-parameter is this tool's own flag, not a user preference: strip
# every copy so it is added exactly once, after the user's flags.
configured_flags="$(obbw_get flags)"
user_flags=""
for configured_flag in $configured_flags; do
  case "$configured_flag" in
    -Wunused-parameter) ;;
    *) user_flags="${user_flags:+$user_flags }$configured_flag" ;;
  esac
done
obbw_put flags "$user_flags" cli
effective_flags="$(obbw_cli_effective_flags)" || exit $?
warning_flags="${effective_flags:+$effective_flags }-Wunused-parameter"
obbw_cli_resolve_profiles "$warning_flags" || exit $?
OPENBREWBYWEIGHT_ARCH="$(openbrewbyweight_resolve_board "$(obbw_get arch)")" || exit 2

raw_report="$output_path/gcc-warnings-raw.txt"
report="$output_path/gcc-warnings.txt"

echo "Building $OPENBREWBYWEIGHT_ARCH (IDF) with extra GCC warnings..."
# The build stage derives the profile defines from the forwarded switches; it
# refuses them as raw --flags.
obbw_cli_flags_for development release no_auth_admin jtag
OPENBREWBYWEIGHT_NONINTERACTIVE=1 ./scripts/internal/build-idf \
  --hardware "$(obbw_get hardware_config)" --machine "$(obbw_get machine_config)" \
  --webui-language "$(obbw_get webui_language)" ${OBBW_CLI_FORWARD[@]+"${OBBW_CLI_FORWARD[@]}"} \
  --flags "${user_flags:+$user_flags }-Wunused-parameter" >"$raw_report" 2>&1
build_status=$?

obbw_cli_save

if [[ $build_status -ne 0 ]]; then
  cat "$raw_report" >&2
  printf 'Architecture: %s\nBuild exit status: %d\n' \
    "$OPENBREWBYWEIGHT_ARCH" "$build_status" > "$output_path/README.txt"
  echo "Build failed; log saved under $OUTPUT_DIR/gcc-warnings-raw.txt" >&2
  exit "$build_status"
fi

# ESP-IDF builds the SDK and managed components too. Keep each warning block
# only when its primary location is in a project-owned source tree; associated
# context and trace lines (source snippets, "In function ..." notes) are
# retained so the diagnostic remains useful.
awk -v openbrewbyweight="$ROOT/src/" \
    -v espresso_scale_ble="$ROOT/libraries/EspressoScaleBLE/" \
    -v idf_main="$ROOT/idf/main/" \
    -v idf_components="$ROOT/idf/components/" '
  /^[^:]+:[0-9]+:[0-9]+: warning:/ {
    keep = index($0, openbrewbyweight) == 1 || \
           index($0, espresso_scale_ble) == 1 || \
           index($0, idf_main) == 1 || \
           index($0, idf_components) == 1
    inblock = keep
    if (keep) print
    next
  }
  /^[^:]+:[0-9]+:[0-9]+: error:/ { keep = 0; inblock = 0; next }
  inblock && /^[ \t][ \t]*/ { print; next }
  { inblock = 0 }
' "$raw_report" > "$report"

warnings_status=0

if [[ -s "$report" ]]; then
  warnings_status=1
fi

printf 'Architecture: %s\nExtra warning flags: %s\nBuild exit status: %d\n' \
  "$OPENBREWBYWEIGHT_ARCH" "$warning_flags" "$warnings_status" > "$output_path/README.txt"

echo "Report saved under $OUTPUT_DIR/"
exit "$warnings_status"
