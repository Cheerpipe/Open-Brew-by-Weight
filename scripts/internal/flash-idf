#!/usr/bin/env bash
# Flash an already compiled ESP-IDF image over USB.
set -euo pipefail

INTERNAL_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_DIR="$(CDPATH='' cd -- "$INTERNAL_DIR/.." && pwd)"
# shellcheck source=scripts/openbrewbyweight_board.sh
source "$SCRIPT_DIR/openbrewbyweight_board.sh"
# shellcheck source=scripts/openbrewbyweight_cli.sh
source "$SCRIPT_DIR/openbrewbyweight_cli.sh"
# shellcheck source=scripts/openbrewbyweight_idf.sh
source "$SCRIPT_DIR/openbrewbyweight_idf.sh"

usage() {
  cat <<EOF
Internal flash stage. Use: ./scripts/dev flash [monitor] --confirm [flags]

Flash an ESP-IDF firmware binary over USB. Without --image, uses the
already-built binary for the selected profile pair; it never rebuilds or
changes that image. Use ./scripts/dev build --webui-language <code> first to select the
WebUI language. With --no-check, existing outputs are flashed without identity
verification. Does not open the monitor. This is the official USB flash path.

Required parameters: --port, --hardware and --machine. An --image must carry
the identity of that profile pair.

$(obbw_flag_help)

$(openbrewbyweight_arch_help)

Examples through the public facade:
  ./scripts/dev flash --confirm --port /dev/cu.usbmodem2101 \
    --hardware esp32-s3-relay-x1-speaker --machine rancilio-silvia-pro-x
  ./scripts/dev flash --confirm --port /dev/cu.usbmodem2101 \
    --hardware esp32-s3-relay-x1-speaker --machine la-marzocco-linea-micra \
    --erase-all
EOF
}

obbw_cli_parse "$@" || exit $?
if [[ "$OBBW_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

if obbw_is_set webui_language; then
  echo '--webui-language is build-only; run ./scripts/dev build with it before flashing.' >&2
  exit 2
fi

if [[ "$OBBW_CLI_ERASE_ALL" == "1" ]] && obbw_is_set image; then
  echo '--erase-all cannot be combined with --image.' >&2
  echo 'A blank chip needs the project bootloader, partition table, otadata, and application.' >&2
  exit 2
fi

obbw_cli_resolve "port hardware_config machine_config" || exit $?
obbw_cli_resolve_profiles "" check || exit $?
obbw_cli_normalize_image || exit $?
OPENBREWBYWEIGHT_ARCH="$(openbrewbyweight_resolve_board "$(obbw_get arch)")"
obbw_idf_source
obbw_idf_py_args

cd "$OBBW_CLI_ROOT"

image="$IDF_IMAGE"
if obbw_is_set image; then
  image="$(obbw_get image)"
else
  obbw_idf_require_image
fi

if [[ "$OBBW_CLI_NO_CHECK" == "1" ]]; then
  echo "Skipping local image verification (--no-check)."
else
  command -v node >/dev/null 2>&1 || {
    echo "node not found on PATH (needed to verify the firmware image)." >&2
    exit 127
  }
  echo "Local image identity:"
  node ./scripts/image_tag.js "$image" --expect-arch "$OPENBREWBYWEIGHT_ARCH" \
    --expect-hardware "$OPENBREWBYWEIGHT_HARDWARE_COMPAT" \
    --expect-machine "$OPENBREWBYWEIGHT_MACHINE_COMPAT"
fi

port="$(obbw_get port)"
echo "Flashing $image ($OPENBREWBYWEIGHT_ARCH) via $port (IDF)"

command -v esptool >/dev/null 2>&1 || {
  echo "esptool not found on PATH (did ESP-IDF export.sh run?)." >&2
  exit 127
}

partition_bin="$(mktemp "${TMPDIR:-/tmp}/openbrewbyweight-partition.XXXXXX")"
partition_csv="$(mktemp "${TMPDIR:-/tmp}/openbrewbyweight-partition-csv.XXXXXX")"
cleanup_partition_probe() {
  rm -f "$partition_bin" "$partition_csv"
}
trap cleanup_partition_probe EXIT HUP INT TERM

# Prints type,subtype,offset,size of partition $2 in partition CSV $1.
partition_row() {
  awk -F, -v name="$2" '{gsub(/[[:space:]]/, "")} $1 == name {print $2 "," $3 "," $4 "," $5; exit}' "$1"
}

installed_layout=unknown
installed_app0_offset=""
if esptool --chip esp32s3 --port "$port" read-flash 0x8000 0x1000 "$partition_bin" >/dev/null; then
  if python -c 'import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes(); sys.exit(0 if b and all(x == 255 for x in b) else 1)' "$partition_bin"; then
    installed_layout=blank
  elif python "$IDF_PATH/components/partition_table/gen_esp32part.py" --quiet \
    "$partition_bin" "$partition_csv" >/dev/null 2>&1; then
    installed_layout=present
    IFS=, read -r _ _ installed_app0_offset _ <<<"$(partition_row "$partition_csv" app0)"
  fi
fi

current_csv="$IDF_PROJECT/partitions-$OPENBREWBYWEIGHT_ARCH.csv"
if [[ "$OBBW_CLI_ERASE_ALL" != "1" && "$installed_layout" == "present" ]]; then
  # Only the exact current project layout is accepted: every row must match
  # by name, type, subtype, offset and size. Any other table, including every
  # pre-v1 development layout, needs --erase-all.
  python - "$partition_csv" "$current_csv" <<'PY' || {
import csv, sys
def number(value):
    value = value.strip()
    return int(value[:-1], 0) * {'K': 1024, 'M': 1048576}[value[-1]] if value[-1:] in ('K', 'M') else int(value, 0)
def layout(path):
    rows = {}
    with open(path) as source:
        for row in csv.reader(line for line in source if not line.startswith('#')):
            if row:
                subtype = row[2].strip()
                rows[row[0].strip()] = (row[1].strip(), number(subtype) if subtype[:1].isdigit() else subtype,
                                        number(row[3]), number(row[4]))
    return rows
sys.exit(0 if layout(sys.argv[1]) == layout(sys.argv[2]) else 1)
PY
    printf 'Installed partition table is not the current %s project layout.\n' "$OPENBREWBYWEIGHT_ARCH" >&2
    echo 'Re-run with --erase-all only if you explicitly intend to destroy all saved data: an in-place flash is not possible.' >&2
    exit 1
  }
fi

if [[ "$OBBW_CLI_ERASE_ALL" == "1" ]]; then
  echo 'Erasing the complete flash: firmware, settings, Wi-Fi, calibration, and history.'
  esptool --chip esp32s3 --port "$port" erase-flash
elif [[ "$installed_layout" == "unknown" ]]; then
  echo 'Could not verify the installed partition layout.' >&2
  exit 1
fi

if obbw_is_set image; then
  # An external application image replaces app0 only. Bootloader and partition
  # table remain in place, so the selected image must match this architecture.
  if [[ "$installed_layout" != "present" || -z "$installed_app0_offset" ]]; then
    echo 'An external image requires a readable installed partition table.' >&2
    exit 1
  fi
  esptool --chip esp32s3 --port "$port" write-flash \
    "$installed_app0_offset" "$image"
else
  # Flash the already-built project outputs directly. `idf.py flash` would
  # re-run the build target and could silently regenerate a different WebUI.
  if [[ ! -f "$IDF_BUILD_DIR/flash_args" ]]; then
    echo "$IDF_BUILD_DIR/flash_args does not exist." >&2
    echo "Build first with --hardware and --machine, or provide --image." >&2
    exit 1
  fi
  # flash_args lists bootloader, partition table, otadata and app at their
  # offsets with relative paths, so esptool must run from the build directory.
  (
    cd "$IDF_BUILD_DIR" || exit 1
    esptool --chip esp32s3 --port "$port" write-flash @flash_args
  )
fi

obbw_cli_save
