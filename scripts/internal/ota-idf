#!/usr/bin/env bash
# Update ESP-IDF controller firmware over Wi-Fi, without a USB cable.
set -euo pipefail

INTERNAL_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_DIR="$(CDPATH='' cd -- "$INTERNAL_DIR/.." && pwd)"
# shellcheck source=scripts/openbrewbyweight_board.sh
source "$SCRIPT_DIR/openbrewbyweight_board.sh"
# shellcheck source=scripts/openbrewbyweight_cli.sh
source "$SCRIPT_DIR/openbrewbyweight_cli.sh"
# shellcheck source=scripts/openbrewbyweight_idf.sh
source "$SCRIPT_DIR/openbrewbyweight_idf.sh"
# shellcheck source=scripts/openbrewbyweight_ota.sh
source "$SCRIPT_DIR/openbrewbyweight_ota.sh"

usage() {
  cat <<EOF
Internal OTA stage. Use: ./scripts/dev ota [monitor] --confirm [flags]

Upload the already-built ESP-IDF image to the controller, verify it, and leave
it ready to boot.

Required parameters: --host, --hardware and --machine. An --image must carry
the identity of that profile pair. Supply the device password through the
hidden prompt, OPENBREWBYWEIGHT_DEVICE_PASSWORD, or --password-stdin.

$(obbw_flag_help)

$(openbrewbyweight_arch_help)

Example through the public facade:
  ./scripts/dev ota --confirm --hardware esp32-s3-relay-x1-speaker \
    --machine rancilio-silvia-pro-x --host 192.168.1.50 \
    --yes --wait-for-confirmation

Without --image, the image comes from the selected profile pair's build folder.
Use ./scripts/dev build ota to build and upload in one command.

Use --yes to assume yes for every prompt: it commits without asking and, when
a different image owns the update slot, discards it automatically. Use
--wait-for-confirmation independently to wait until the rebooted firmware
confirms itself through its HTTP API.

Resumable OTA rejects --no-check because SHA-256, architecture, hardware
profile, machine profile, and version are required to safely resume one image.

When a different image owns the update slot, an interactive run explains the
situation and asks whether to discard it (Y is the default). --discard-ota-session
answers that question in advance; matching images resume automatically and
never need the flag.
EOF
}

obbw_cli_parse "$@" || exit $?
if obbw_cli_help_requested; then
  usage
  exit 0
fi
if [[ "$OBBW_CLI_YES" != "1" ]] && ! obbw_can_prompt; then
  echo 'Non-interactive OTA requires --yes before any transfer is started.' >&2
  exit 2
fi

obbw_cli_resolve "hardware_config machine_config host password" || exit $?
obbw_cli_resolve_profiles "" check || exit $?
obbw_cli_normalize_image || exit $?
OPENBREWBYWEIGHT_ARCH="$(openbrewbyweight_resolve_board "$(obbw_get arch)")"
obbw_idf_resolve_paths

root="$OBBW_CLI_ROOT"
cd "$root"

image="$IDF_IMAGE"
if obbw_is_set image; then
  image="$(obbw_get image)"
else
  obbw_idf_require_image
fi

command -v node >/dev/null 2>&1 || {
  echo "node not found on PATH (needed to verify the firmware image)." >&2
  exit 127
}
node ./scripts/image_tag.js "$image" --expect-arch "$OPENBREWBYWEIGHT_ARCH" \
  --expect-hardware "$OPENBREWBYWEIGHT_HARDWARE_COMPAT" \
  --expect-machine "$OPENBREWBYWEIGHT_MACHINE_COMPAT" >/dev/null

trap obbw_ota_cleanup EXIT
obbw_ota_run "$image" "$OPENBREWBYWEIGHT_ARCH" "$(obbw_get host)" \
  "$(obbw_get password)" "$OBBW_CLI_YES" "$OBBW_CLI_WAIT_FOR_CONFIRMATION" \
  "$OBBW_CLI_NO_CHECK" "$OBBW_CLI_DISCARD_OTA_SESSION" || exit $?
obbw_cli_save
