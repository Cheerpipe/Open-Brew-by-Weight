#!/usr/bin/env bash
# Open the ESP-IDF serial monitor.
set -euo pipefail

INTERNAL_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_DIR="$(CDPATH='' cd -- "$INTERNAL_DIR/.." && pwd)"
# shellcheck source=scripts/openbrewbyweight_board.sh
source "$SCRIPT_DIR/openbrewbyweight_board.sh"
# shellcheck source=scripts/openbrewbyweight_cli.sh
source "$SCRIPT_DIR/openbrewbyweight_cli.sh"
# shellcheck source=scripts/openbrewbyweight_idf.sh
source "$SCRIPT_DIR/openbrewbyweight_idf.sh"

usage() {
  cat <<EOF
Internal monitor stage. Use: ./scripts/dev monitor [flags]

Start the ESP-IDF serial monitor. With --hardware and --machine, use that
variant's ELF to decode backtraces.
Exit: Ctrl+].

Required parameters: --port and --speed.

$(obbw_flag_help)

Examples through the public facade:
  ./scripts/dev monitor --port /dev/cu.usbmodem2101 --speed 115200
  ./scripts/dev monitor -p /dev/cu.usbmodem2101 -s 115200 \
    --hardware esp32-s3-relay-x1-speaker --machine rancilio-silvia-pro-x
EOF
}

obbw_cli_parse "$@" || exit $?
if obbw_cli_help_requested; then
  usage
  exit 0
fi

obbw_cli_resolve "port speed" || exit $?
if obbw_is_set hardware_config || obbw_is_set machine_config; then
  if ! obbw_is_set hardware_config || ! obbw_is_set machine_config; then
    echo "--hardware and --machine must be used together." >&2
    exit 2
  fi
  obbw_cli_resolve_profiles "" check || exit $?
fi
OBBW_IDF_QUIET=1
obbw_idf_source

port="$(obbw_get port)"
speed="$(obbw_get speed)"

# Persist before exec: the monitor runs until the user stops it.
obbw_cli_save

echo "Serial monitor on $port ($speed)"
if obbw_is_set arch; then
  OPENBREWBYWEIGHT_ARCH="$(openbrewbyweight_resolve_board "$(obbw_get arch)")" || exit 2
  obbw_idf_py_args
  exec idf.py "${IDF_PY_ARGS[@]}" -p "$port" -b "$speed" monitor
fi
exec python "$IDF_PATH/tools/idf_monitor.py" -p "$port" -b "$speed"
