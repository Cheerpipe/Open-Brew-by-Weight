#!/usr/bin/env bash
# Compile Open Brew by Weight with ESP-IDF (Arduino-ESP32 as a component) into
# build-idf/<hardware>--<machine>. This is the official supported firmware build.
set -euo pipefail

INTERNAL_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_DIR="$(CDPATH='' cd -- "$INTERNAL_DIR/.." && pwd)"
# shellcheck source=scripts/openbrewbyweight_board.sh
source "$SCRIPT_DIR/openbrewbyweight_board.sh"
# shellcheck source=scripts/openbrewbyweight_cli.sh
source "$SCRIPT_DIR/openbrewbyweight_cli.sh"
# shellcheck source=scripts/openbrewbyweight_idf.sh
source "$SCRIPT_DIR/openbrewbyweight_idf.sh"

usage() {
  cat <<EOF
Internal build stage. Use: ./scripts/dev build [flash|ota] [monitor] [flags]

Compile Open Brew by Weight with ESP-IDF (official supported path) and write
artifacts to build-idf/<hardware>--<machine>.

Required parameters: --hardware and --machine. --flags is optional.
The WebUI language defaults to en and is selected at compile time.

$(obbw_flag_help)

$(openbrewbyweight_arch_help)

Firmware optimization level (build-only, exclusive, not persisted):
  --o0 -O0 debug without optimization; --og -Og IDF debug default;
  --o2 -O2 performance (repository default); --os -Os size;
  -O1 and -O3 are not ESP-IDF Kconfig levels and are rejected.
  The level is a Kconfig choice: the build reconfigures when it changes and
  the verifier checks the selected level. mbedTLS keeps its own level.
  --force-sdkconfig-regenerate refreshes repository defaults in this variant
  and discards local menuconfig choices.

Recommended development compile flags (Enter at the prompt):
  $OBBW_CLI_DEFAULT_FLAGS

Requires ESP-IDF 6.1.0. If IDF_PATH is unset, ${IDF_DEFAULT_HOME} is used when
it exists.

BLE backend:
  Native ESP-IDF NimBLE (only production backend).

Examples through the public facade:
  ./scripts/dev build --hardware esp32-s3-relay-x1-speaker \
    --machine rancilio-silvia-pro-x
  ./scripts/dev build --hardware esp32-s3-relay-x1-speaker \
    --machine la-marzocco-linea-micra --webui-language EN
  ./scripts/dev build --hardware esp32-s3-relay-x1-speaker-reed \
    --machine rancilio-silvia-pro-x-reed --development
EOF
}

if [[ "${OBBW_BUILD_LOCKED:-}" != "1" ]]; then
  obbw_cli_parse "$@" || exit $?
  if [[ "$OBBW_CLI_HELP_REQUESTED" == "1" ]]; then
    usage
    exit 0
  fi

  obbw_cli_resolve "hardware_config machine_config webui_language" "flags" || exit $?
  effective_flags="$(obbw_cli_effective_flags)" || exit $?
  # An explicit --release is a publishable image: its version must not be -dirty.
  if [[ "$OBBW_CLI_RELEASE" == "1" && -n "$(git -C "$OBBW_CLI_ROOT" status --porcelain)" ]]; then
    echo '--release needs a clean Git tree, untracked files included; commit or remove the changes, or omit --release for a local build.' >&2
    exit 2
  fi

  root="$OBBW_CLI_ROOT"
  cd "$root"
  obbw_cli_resolve_profiles "$effective_flags" || exit $?
  printf '%s\n' "$OBBW_PROFILE_OUTPUT"

  # Serialize builds of one tree across parallel agents and sessions: the
  # remainder of this script mutates the variant tree (generated headers,
  # sdkconfig, artifacts), so it holds that tree's lock. Other trees build in
  # parallel; idf/CMakeLists.txt makes their CMake configures take turns. Prompted
  # input happened above, so no interactive pause holds the lock. The shell state crosses the exec via a
  # declare -p dump (arrays survive; export would flatten them); with-flock
  # holds the lock and execs the second pass, so the kernel releases it on
  # every exit path including signals.
  OBBW_BUILD_STATE_FILE="$(mktemp "${TMPDIR:-/tmp}/openbrewbyweight-build-state.XXXXXX")"
  state_vars=()
  read -r -d '' -a state_vars < <(compgen -A variable 2>/dev/null | grep -E '^(OBBW_|OPENBREWBYWEIGHT_)') || true
  { [[ ${#state_vars[@]} -eq 0 ]] || declare -p "${state_vars[@]}" 2>/dev/null; } \
    >"$OBBW_BUILD_STATE_FILE" || true
  OBBW_BUILD_LOCKED=1 OBBW_BUILD_STATE_FILE="$OBBW_BUILD_STATE_FILE" \
    exec python3 "$SCRIPT_DIR/internal/with-flock" \
    "$OBBW_IDF_BUILD_ROOT/.locks/$OPENBREWBYWEIGHT_VARIANT.lock" \
    bash "$SCRIPT_DIR/internal/${0##*/}"
fi

eval "$(cat "$OBBW_BUILD_STATE_FILE")"
rm -f "$OBBW_BUILD_STATE_FILE"
root="$OBBW_CLI_ROOT"
cd "$root"
effective_flags="$(obbw_cli_effective_flags)" || exit $?

OPENBREWBYWEIGHT_ARCH="$(openbrewbyweight_resolve_board "$(obbw_get arch)")"
obbw_idf_source
lock_file="$root/idf/dependencies.lock"
[[ -f "$lock_file" ]] || { echo "Missing IDF component lock: $lock_file" >&2; exit 1; }
lock_sha="$(git hash-object "$lock_file")"

# Map the exclusive CLI level flags to their ESP-IDF Kconfig choices. Empty
# keeps the repository default (-O2 / PERF). obbw_idf_py_args registers the
# generated overlay as the last SDKCONFIG_DEFAULTS entry so the chosen level
# wins over every earlier default file.
case "${OBBW_CLI_OPT_LEVEL:-}" in
  --o0) OBBW_IDF_OPT_LEVEL_KCONFIG=CONFIG_COMPILER_OPTIMIZATION_NONE ;;
  --og) OBBW_IDF_OPT_LEVEL_KCONFIG=CONFIG_COMPILER_OPTIMIZATION_DEBUG ;;
  --o2) OBBW_IDF_OPT_LEVEL_KCONFIG=CONFIG_COMPILER_OPTIMIZATION_PERF ;;
  --os) OBBW_IDF_OPT_LEVEL_KCONFIG=CONFIG_COMPILER_OPTIMIZATION_SIZE ;;
  *)    OBBW_IDF_OPT_LEVEL_KCONFIG=CONFIG_COMPILER_OPTIMIZATION_PERF ;;
esac
export OBBW_IDF_OPT_LEVEL_KCONFIG

command -v node >/dev/null 2>&1 || {
  echo "node not found on PATH (needed for the Web UI and OTA marker)." >&2
  exit 127
}

echo "Building $OPENBREWBYWEIGHT_VARIANT (IDF, BLE=nimble, allocator=external)"

export OPENBREWBYWEIGHT_EXTRA_FLAGS
OPENBREWBYWEIGHT_EXTRA_FLAGS="$effective_flags"
echo "Extra compile flags: ${OPENBREWBYWEIGHT_EXTRA_FLAGS:-(none)}"
# The JTAG defaults overlay follows the extra flags exported above.
obbw_idf_py_args

mkdir -p "$IDF_BUILD_DIR"
# A tree configured for another project or toolchain needs a full clean;
# ordinary defaults drift below only invalidates generated configuration under
# the variant lock.
if [[ -f "$IDF_BUILD_DIR/CMakeCache.txt" ]] &&
   { ! grep -Fqx "CMAKE_PROJECT_NAME:STATIC=$IDF_PROJECT_NAME" "$IDF_BUILD_DIR/CMakeCache.txt" ||
     ! grep -Fq "CMAKE_TOOLCHAIN_FILE:FILEPATH=${IDF_PATH}/tools/cmake/" "$IDF_BUILD_DIR/CMakeCache.txt"; }; then
  echo "Cleaning stale IDF build tree"
  rm -rf "$IDF_BUILD_DIR"
  mkdir -p "$IDF_BUILD_DIR"
fi

echo "Building IDF firmware $OPENBREWBYWEIGHT_ARCH → $IDF_BUILD_DIR"
target_ready=1
if [[ ! -f "$IDF_SDKCONFIG" && ! -f "$IDF_BUILD_DIR/CMakeCache.txt" ]] ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_IDF_TARGET="esp32s3"$' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_BUILD_DIR/CMakeCache.txt" ]] && ! grep -q '^IDF_TARGET:STRING=esp32s3$' "$IDF_BUILD_DIR/CMakeCache.txt"; }; then
  target_ready=0
fi
obbw_idf_sync_extra_flags
obbw_idf_emit_opt_overlay
config_fingerprint="$(obbw_idf_config_fingerprint)"
fingerprint_file="$IDF_BUILD_DIR/sdkconfig.inputs.sha256"
obbw_idf_refresh_config "$config_fingerprint"

if [[ "$target_ready" == "0" ]]; then
  obbw_idf_prepare_set_target
  obbw_idf_py set-target esp32s3
fi

# set-target performs fullclean and removes generated files from a fresh
# variant tree. Re-emit the validated profile after it completes and before
# any translation unit is compiled.
python3 ./scripts/resolve_build_profiles.py \
  --hardware "$(obbw_get hardware_config)" \
  --machine "$(obbw_get machine_config)" \
  --flags="$effective_flags" --output-root "$OBBW_IDF_BUILD_ROOT" >/dev/null

# The generated overlay lives outside the variant tree cleared by set-target.
obbw_idf_emit_opt_overlay

./scripts/gen_version.sh "$OPENBREWBYWEIGHT_ARCH" \
  "$OPENBREWBYWEIGHT_HARDWARE_COMPAT" "$OPENBREWBYWEIGHT_MACHINE_COMPAT" \
  "$OPENBREWBYWEIGHT_GENERATED_DIR/OpenBrewByWeightVersion.h" split

# Generate the Web UI after the firmware identity header so the baked cache
# version equals the reported firmware version; the UI compares them to reload
# a stale cached shell exactly once after an update.
echo "WebUI language: $(obbw_get webui_language)"
# Bake the shell body class in development builds so the dev UI never paints
# the lock panel or the timed UI Override section.
webui_args=()
grep -q -- '-DOPEN_BREW_BY_WEIGHT_DEVELOPMENT=1' <<<"$effective_flags" && webui_args+=(--development)
# Remote control builds embed the fixed Home action bar; without the flag the
# panel markup and CSS are omitted so a disabled feature costs no UI bytes.
grep -q -- '-DOPEN_BREW_BY_WEIGHT_ENABLE_REMOTE_MACHINE_CONTROL=1' <<<"$effective_flags" \
  || webui_args+=(--no-remote-control)
# The resolved profile carries everything the Web UI shows about the machine:
# its type, La Marzocco integration, glyph, brand, model, and everyday name.
node ./scripts/gen_web_ui.js \
  --build-profile "$OPENBREWBYWEIGHT_GENERATED_DIR/build-profile.json" \
  --output "$OPENBREWBYWEIGHT_GENERATED_DIR/OpenBrewByWeightWebAssetsGzip.h" \
  --version "$(sed -n 's/^#define FW_VERSION_STRING "\(.*\)"$/\1/p' \
    "$OPENBREWBYWEIGHT_GENERATED_DIR/OpenBrewByWeightVersion.cpp")" \
  --webui-language "$(obbw_get webui_language)" ${webui_args[@]+"${webui_args[@]}"}

obbw_idf_commit_extra_flags_stamp

if [[ "${OPENBREWBYWEIGHT_IDF_LINK_INPUTS_ONLY:-0}" == "1" ]]; then
  # Analysis builds (dead-code-idf) compile every input of the application
  # link and stop there: code built for analysis need not fit the image.
  [[ -f "$IDF_BUILD_DIR/CMakeCache.txt" ]] || obbw_idf_py reconfigure 2>&1 | obbw_idf_filter_output
  link_inputs=()
  while read -r link_input; do link_inputs+=("$link_input"); done < <(
    ninja -C "$IDF_BUILD_DIR" -t query "${IDF_ELF##*/}" |
      awk '/^  outputs:/ { exit } /^    / { sub(/^ *(\|\|? )?/, ""); print }')
  [[ ${#link_inputs[@]} -gt 0 ]] || { echo "No link inputs found for ${IDF_ELF##*/}" >&2; exit 1; }
  ninja -C "$IDF_BUILD_DIR" "${link_inputs[@]}" 2>&1 | obbw_idf_filter_output
else
  obbw_idf_py build 2>&1 | obbw_idf_filter_output
fi
if [[ "$(git hash-object "$lock_file")" != "$lock_sha" ]]; then
  echo "IDF component lock changed during build; update it explicitly and review the diff." >&2
  exit 1
fi
[[ "${OPENBREWBYWEIGHT_IDF_LINK_INPUTS_ONLY:-0}" == "1" ]] && exit 0

obbw_idf_verify_firmware

# A local path in an image exposes the developer's machine and makes its size
# depend on the checkout; idf/CMakeLists.txt maps them all away.
for local_path in "$root" "$HOME" ../src/ ../idf/ ../libraries/; do
  if LC_ALL=C grep -aqF "$local_path" "$IDF_IMAGE"; then
    echo "Image contains the local path $local_path; check -fmacro-prefix-map." >&2
    exit 1
  fi
done

python -m esp_idf_size --format json2 -o "$IDF_BUILD_DIR/size.json" \
  "$IDF_MAP"
# Only a flag-free release build is the shipped image its baseline describes.
size_check_profile=--release
[[ -n "$effective_flags" ]] && size_check_profile=--custom-flags
[[ "${OBBW_CLI_DEVELOPMENT:-0}" == "1" ]] && size_check_profile=--development
node "$root/src/tests/check_firmware_size.js" "$IDF_IMAGE" \
  --arch "$OPENBREWBYWEIGHT_ARCH" "$size_check_profile"
printf '%s\n' "$config_fingerprint" > "$fingerprint_file"

identity="$(node ./scripts/image_tag.js "$IDF_IMAGE" --json)"
elf_sha="$(node -e 'process.stdout.write(JSON.parse(process.argv[1]).elfSha256)' "$identity")"
archive_parent="$root/artifacts/firmware/$OPENBREWBYWEIGHT_VARIANT"
archive="$archive_parent/$elf_sha"
mkdir -p "$archive_parent"
if [[ -d "$archive" ]]; then
  if ! cmp -s "$IDF_ELF" "$archive/$IDF_PROJECT_NAME.elf" ||
    ! cmp -s "$IDF_IMAGE" "$archive/$IDF_PROJECT_NAME.bin"; then
    echo "Firmware archive collision: $archive" >&2
    exit 1
  fi
else
  stage="$(mktemp -d "$archive_parent/.pending.XXXXXXXX")"
  trap 'rm -rf "$stage"' EXIT
  cp "$IDF_ELF" "$stage/$IDF_PROJECT_NAME.elf"
  cp "$IDF_IMAGE" "$stage/$IDF_PROJECT_NAME.bin"
  printf '%s\n' "$identity" >"$stage/identity.json"
  mv "$stage" "$archive"
  trap - EXIT
fi
echo "Firmware archive: $archive"
artifact="$IDF_BUILD_DIR/${IDF_PROJECT_NAME}-${OPENBREWBYWEIGHT_VARIANT}.bin"
cp "$IDF_IMAGE" "$artifact"
echo "Named firmware artifact: $artifact"
obbw_cli_save
