#!/usr/bin/env bash
# Private ordered firmware dispatcher. The supported entry point is scripts/dev.
set -euo pipefail

INTERNAL_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_DIR="$(CDPATH='' cd -- "$INTERNAL_DIR/.." && pwd)"
# shellcheck source=scripts/openbrewbyweight_board.sh
source "$SCRIPT_DIR/openbrewbyweight_board.sh"
# shellcheck source=scripts/openbrewbyweight_cli.sh
source "$SCRIPT_DIR/openbrewbyweight_cli.sh"

usage() {
  cat <<'EOF'
Internal dispatcher. Use ./scripts/dev:
  ./scripts/dev build [flash|ota] [monitor] [options]
  ./scripts/dev flash|ota [monitor] [options]
  ./scripts/dev monitor [options]
EOF
}

stages=()
while [[ $# -gt 0 && "$1" != "--" ]]; do
  stages+=("$1")
  shift
done
[[ $# -gt 0 ]] && shift
case "${stages[*]}" in
  build | flash | ota | monitor | "build flash" | "build ota" | "flash monitor" | \
    "ota monitor" | "build flash monitor" | "build ota monitor") ;;
  *)
    echo "Invalid internal firmware sequence: ${stages[*]:-(empty)}" >&2
    exit 2
    ;;
esac

obbw_cli_parse "$@" || exit $?
if obbw_cli_help_requested; then
  usage
  exit 0
fi

has_stage() {
  [[ " ${stages[*]} " == *" $1 "* ]]
}

emit_build_paths() {
  obbw_cli_resolve_profiles "$(obbw_cli_effective_flags)" check || exit $?
  build_output="$OBBW_CLI_ROOT/build-idf/$OPENBREWBYWEIGHT_VARIANT"
  printf 'Build output folder: %s\n' "$build_output"
  printf 'Flash-ready firmware: %s/openbrewbyweight.bin\n' "$build_output"
}

if has_stage build && obbw_is_set image; then
  echo '--image cannot be combined with build; the built artifact is used.' >&2
  exit 2
fi
if has_stage ota && [[ "$OBBW_CLI_YES" != "1" ]] && ! obbw_can_prompt; then
  echo 'Non-interactive OTA requires --yes before any transfer is started.' >&2
  exit 2
fi

obbw_cli_apply_env
obbw_cli_load_store
if has_stage build && has_stage monitor && [[ "$OBBW_CLI_JTAG" != "1" ]]; then
  echo 'build combined with monitor requires the USB Serial/JTAG console for firmware output; pass --jtag (or --development) or run monitor separately.' >&2
  exit 2
fi
if obbw_is_set hardware_config || obbw_is_set machine_config; then
  if ! obbw_is_set hardware_config || ! obbw_is_set machine_config; then
    echo '--hardware and --machine must be used together.' >&2
    exit 2
  fi
fi
# Build, flash and OTA always need the profile pair; monitor alone does not.
profiles=0
if obbw_is_set hardware_config || has_stage build || has_stage flash || has_stage ota; then
  profiles=1
fi

required=""
optional=""
if has_stage build; then
  required="hardware_config machine_config webui_language"
  optional="flags"
fi
if has_stage flash || has_stage monitor; then
  required="$required port"
fi
if has_stage monitor; then
  required="$required speed"
fi
if has_stage ota; then
  required="$required host password"
fi
if [[ "$profiles" == "1" ]]; then
  has_stage build || required="$required hardware_config machine_config"
fi

obbw_cli_resolve "$required" "$optional" || exit $?
obbw_cli_normalize_image || exit $?
# Check the flags' origin here: forwarding re-emits them to the build as --flags.
if has_stage build; then obbw_cli_effective_flags >/dev/null || exit $?; fi

for stage in "${stages[@]}"; do
  case "$stage" in
    build)
      obbw_cli_flags_for hardware_config machine_config flags webui_language development release no_auth_admin jtag opt_level force_sdkconfig_regenerate
      "$INTERNAL_DIR/build-idf" ${OBBW_CLI_FORWARD[@]+"${OBBW_CLI_FORWARD[@]}"}
      ;;
    flash)
      obbw_cli_flags_for port hardware_config machine_config image no_check erase_all
      "$INTERNAL_DIR/flash-idf" ${OBBW_CLI_FORWARD[@]+"${OBBW_CLI_FORWARD[@]}"}
      ;;
    ota)
      obbw_cli_flags_for hardware_config machine_config host image yes wait_for_confirmation no_check discard_ota_session
      obbw_cli_export_secrets
      "$INTERNAL_DIR/ota-idf" ${OBBW_CLI_FORWARD[@]+"${OBBW_CLI_FORWARD[@]}"}
      ;;
    monitor)
      if [[ "$profiles" == "1" ]]; then
        obbw_cli_flags_for port speed hardware_config machine_config
      else
        obbw_cli_flags_for port speed arch
      fi
      has_stage build && emit_build_paths
      exec "$INTERNAL_DIR/monitor-idf" ${OBBW_CLI_FORWARD[@]+"${OBBW_CLI_FORWARD[@]}"}
      ;;
  esac
done

if has_stage build; then
  emit_build_paths
fi
