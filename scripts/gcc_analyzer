#!/usr/bin/env bash
# Build the firmware with GCC's interprocedural static analyzer enabled.
set -uo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/openbrewbyweight_board.sh
source "$SCRIPT_DIR/openbrewbyweight_board.sh"
# shellcheck source=scripts/openbrewbyweight_cli.sh
source "$SCRIPT_DIR/openbrewbyweight_cli.sh"

ROOT="$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)"
readonly ROOT
readonly OUTPUT_DIR="reports/gcc-analyzer"

usage() {
  cat <<EOF
Usage: ./scripts/gcc_analyzer [flags]

Build Open Brew by Weight with GCC -fanalyzer and save the filtered result to
reports/gcc-analyzer/gcc-analyzer.txt. Replaces the previous report.
The full compile log is kept in gcc-analyzer-raw.txt; the main report keeps
only diagnostics whose primary location is versioned code in this repository.

Required parameters: --hardware and --machine. --flags is optional and appended
to the analysis.

$(obbw_flag_help)

$(openbrewbyweight_arch_help)

Examples:
  ./scripts/gcc_analyzer --hardware esp32-s3-relay-x1-speaker \
    --machine rancilio-silvia-pro-x
EOF
}

obbw_cli_parse "$@" || exit $?
if obbw_cli_help_requested; then
  usage
  exit 0
fi

obbw_cli_resolve "hardware_config machine_config webui_language" "flags" || exit $?

cd "$ROOT" || exit
output_path="$ROOT/$OUTPUT_DIR"
rm -rf "$output_path"
mkdir -p "$output_path"

# -fanalyzer is this tool's own flag, not a user preference: strip every copy
# so it is added exactly once, after the user's flags.
configured_flags="$(obbw_get flags)"
user_flags=""
for configured_flag in $configured_flags; do
  case "$configured_flag" in
    -fanalyzer) ;;
    *) user_flags="${user_flags:+$user_flags }$configured_flag" ;;
  esac
done
obbw_put flags "$user_flags" cli
effective_flags="$(obbw_cli_effective_flags)" || exit $?
analyzer_flags="${effective_flags:+$effective_flags }-fanalyzer"
obbw_cli_resolve_profiles "$analyzer_flags" || exit $?
OPENBREWBYWEIGHT_ARCH="$(openbrewbyweight_resolve_board "$(obbw_get arch)")" || exit 2
echo "Running GCC -fanalyzer for $OPENBREWBYWEIGHT_ARCH..."

raw_report="$output_path/gcc-analyzer-raw.txt"
report="$output_path/gcc-analyzer.txt"

# The build stage derives the profile defines from the forwarded switches; it
# refuses them as raw --flags.
obbw_cli_flags_for development release no_auth_admin jtag
OPENBREWBYWEIGHT_NONINTERACTIVE=1 ./scripts/internal/build-idf \
  --hardware "$(obbw_get hardware_config)" --machine "$(obbw_get machine_config)" \
  --webui-language "$(obbw_get webui_language)" ${OBBW_CLI_FORWARD[@]+"${OBBW_CLI_FORWARD[@]}"} \
  --flags "${user_flags:+$user_flags }-fanalyzer" >"$raw_report" 2>&1
build_status=$?

obbw_cli_save

if [[ $build_status -ne 0 ]]; then
  cat "$raw_report" >&2
  printf 'Architecture: %s\nGCC analyzer exit status: %d\n' \
    "$OPENBREWBYWEIGHT_ARCH" "$build_status" > "$output_path/README.txt"
  echo "Build failed; log saved under $OUTPUT_DIR/gcc-analyzer-raw.txt" >&2
  exit "$build_status"
fi

# GCC also analyzes ESP-IDF and managed components. Keep each warning block
# only when its primary location is in a project-owned source tree; associated
# traces are retained so the diagnostic remains useful.
awk -v openbrewbyweight="$ROOT/src/" \
    -v espresso_scale_ble="$ROOT/libraries/EspressoScaleBLE/" \
    -v idf_main="$ROOT/idf/main/" \
    -v idf_components="$ROOT/idf/components/" '
  /^[^:]+:[0-9]+:[0-9]+: (warning|error):/ {
    if ($0 ~ /\[-Wanalyzer-/) {
      keep = index($0, openbrewbyweight) == 1 || \
             index($0, espresso_scale_ble) == 1 || \
             index($0, idf_main) == 1 || \
             index($0, idf_components) == 1
      if (keep) print
      next
    }
    keep = 0
  }
  keep { print }
' "$raw_report" > "$report"

analyzer_status=0

if grep -q '\[-Wanalyzer-' "$report"; then
  analyzer_status=1
fi

printf 'Architecture: %s\nGCC analyzer exit status: %d\n' \
  "$OPENBREWBYWEIGHT_ARCH" "$analyzer_status" > "$output_path/README.txt"

echo "Report saved under $OUTPUT_DIR/"
exit "$analyzer_status"
