#!/usr/bin/env bash
# Run Cppcheck against an existing ESP-IDF compilation database.
# This script deliberately never builds the firmware.
set -uo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)" || exit $?
# shellcheck source=scripts/openbrewbyweight_board.sh
source "$SCRIPT_DIR/openbrewbyweight_board.sh"
# shellcheck source=scripts/openbrewbyweight_cli.sh
source "$SCRIPT_DIR/openbrewbyweight_cli.sh"
# shellcheck source=scripts/openbrewbyweight_idf.sh
source "$SCRIPT_DIR/openbrewbyweight_idf.sh"

ROOT="$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)" || exit $?
readonly ROOT
readonly SUPPRESSIONS_FILE="$ROOT/scripts/cppcheck-suppressions.txt"

usage() {
  cat << EOF
Usage: ./scripts/static-idf [flags]

Run Cppcheck against a compilation database already produced by ESP-IDF.
Checks warning, performance and portability. \`unusedFunction\` is deliberately
excluded: Cppcheck reports project APIs used across filtered translation units
and build variants as unused. Dead-code review is tracked separately from this
F-21 gate. The output directory is deleted and recreated on every run. This
script never builds the firmware; run ./scripts/dev build separately first.

Required parameters: --arch. For a profile build, pass its directory with
--build-dir. Path overrides are one-shot and are not persisted.

$(obbw_flag_help)

Examples:
  ./scripts/static-idf --arch n16r8
  ./scripts/static-idf -a n16r8 -o reports/analysis-idf-n16r8
EOF
}

obbw_cli_parse "$@" || exit $?
if obbw_cli_help_requested; then
  usage
  exit 0
fi

obbw_cli_resolve "arch" || exit $?
OPENBREWBYWEIGHT_ARCH="$(openbrewbyweight_resolve_board "$(obbw_get arch)")" || exit 2

for tool in cppcheck python3; do
  command -v "$tool" > /dev/null 2>&1 || {
    echo "$tool not found on PATH." >&2
    exit 127
  }
done

obbw_idf_static_paths reports/static-analysis || exit $?

if [[ ! -f "$SUPPRESSIONS_FILE" ]]; then
  echo "Suppressions file $SUPPRESSIONS_FILE does not exist." >&2
  exit 1
fi

obbw_idf_audit_translation_units || {
  echo "Translation-unit coverage audit failed." >&2
  exit 1
}

printf 'Build database: %s\n' "$compile_commands" > "$output_path/README.txt"
printf 'Generated: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" >> "$output_path/README.txt"

# The firmware build includes SDK headers with -isystem so the project's
# strict warnings skip third-party code. Cppcheck searches quoted includes
# (sdkconfig.h, ESP-IDF headers) only in -I directories, so it reads a copy of
# the database with those directories as plain include paths.
cppcheck_database="$output_path/compile_commands.json"
python3 - "$compile_commands" "$cppcheck_database" <<'PY'
import json, re, sys
entries = json.load(open(sys.argv[1]))
for entry in entries:
    if "command" in entry:
        entry["command"] = re.sub(r"(^|\s)-isystem\s+", r"\1-I", entry["command"])
    if "arguments" in entry:
        entry["arguments"] = ["-I" if arg == "-isystem" else arg for arg in entry["arguments"]]
json.dump(entries, open(sys.argv[2], "w"))
PY

echo "Running Cppcheck (warning, performance, portability) on $build_dir..."
cppcheck \
  -j "$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)" \
  --project="$cppcheck_database" \
  --suppressions-list="$SUPPRESSIONS_FILE" \
  --file-filter="$ROOT/src/*.cpp" \
  --file-filter='*/libraries/EspressoScaleBLE/src/*.cpp' \
  --file-filter='*/libraries/EspressoScaleBLE/src/nimble/*.cpp' \
  --file-filter='*/libraries/EspressoScaleBLE/src/protocols/*.cpp' \
  --file-filter='*/idf/main/*.cpp' \
  --file-filter='*/idf/components/OpenBrewByWeightBleRuntime/*.cpp' \
  --enable=warning,performance,portability \
  --inline-suppr \
  --inconclusive \
  --error-exitcode=1 \
  2>&1 | tee "$output_path/cppcheck.txt"
cppcheck_status=${PIPESTATUS[0]}

printf '\nCppcheck exit status: %d\n' "$cppcheck_status" | tee -a "$output_path/README.txt"

echo "Reports saved under $output_dir/"
if [[ $cppcheck_status -ne 0 ]]; then
  echo "Analysis finished with diagnostics or an error; check the reports." >&2
  exit 1
fi

obbw_cli_save
